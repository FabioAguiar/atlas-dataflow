# Real environment files — never commit files containing real values to the repository.
# Operators copy .env.example to .env and fill in real values locally.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# Node
node_modules/
dist/
build/

# Editor / OS
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Pytest/cache
.pytest_cache/
.coverage
htmlcov/

# Atlas generated runtime evidence
/evidence/

# Data Workbench — local authoring outputs (see README.md, "Data Workbench
# boundary"). These stay local/exploratory unless a later implementation
# request explicitly promotes them into pipeline/contracts/releases/publisher
# inputs. Helper modules, docs, and dataset-local config/modeling-intent
# files are intended source and are NOT covered by these patterns.
workbench/**/runs/
workbench/**/.cache/
workbench/**/raw/
workbench/**/exploratory/
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Model binaries and other heavyweight authoring artifacts
*.ckpt
*.pt
*.pth
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.onnx

# Dados
data/

atlas_dataflow.egg-info/