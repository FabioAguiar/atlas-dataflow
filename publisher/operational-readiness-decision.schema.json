{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-dataflow.local/schemas/publisher/operational-readiness-decision.schema.json",
  "title": "Atlas DataFlow Operational Readiness Decision",
  "description": "Project Spec S0189. A governed, hash-bound record of an Admin operator's explicit operational-readiness decision for one validated external fitted-model run. Bound to the exact source run, candidate identity, release-candidate hash and predictive-bundle hash it was reviewed against. Carries no operator-controlled promotion_allowed/registry_update_allowed field -- promotion eligibility is derived downstream by publisher/validate.py from this decision's own confirmed fields. This schema does not retrain a model, reselect a model, reoptimize a threshold, promote a release, or update the registry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "created_at",
    "source_run",
    "candidate_identity",
    "source_bindings",
    "source_readiness",
    "decision",
    "boundary_confirmations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "operational-readiness-decision.v1"
    },
    "artifact_kind": {
      "type": "string",
      "const": "operational_readiness_decision"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id"],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      }
    },
    "candidate_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_slug", "release_id", "release_version"],
      "properties": {
        "dataset_slug": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "release_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[-._][a-z0-9]+)*$"
        },
        "release_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_candidate", "predictive_bundle", "validated_run_terminal_result"],
      "description": "All three bindings are computed by Atlas from the immutable source artifacts at review time. The operator never supplies or edits any of these values.",
      "properties": {
        "release_candidate": { "$ref": "#/$defs/artifact_binding" },
        "predictive_bundle": { "$ref": "#/$defs/artifact_binding" },
        "validated_run_terminal_result": { "$ref": "#/$defs/artifact_binding" }
      }
    },
    "source_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operational_validity", "operational_threshold", "operational_prediction_available"],
      "description": "An unedited copy of the source predictive bundle's own self-declared external_model_evidence.readiness snapshot at review time, kept only for reduced traceability -- never itself the operator decision.",
      "properties": {
        "operational_validity": {
          "type": "string",
          "enum": ["confirmed", "unconfirmed"]
        },
        "operational_threshold": { "$ref": "#/$defs/source_threshold" },
        "operational_prediction_available": {
          "type": "boolean"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operational_validity",
        "operational_threshold",
        "operational_prediction_available",
        "decision_basis"
      ],
      "description": "The operator's explicit, non-inferred decision. Every field here must be a real operator input -- never copied or defaulted from source_readiness or from the bundle's educational threshold.",
      "properties": {
        "operational_validity": {
          "type": "string",
          "enum": ["confirmed", "unconfirmed"]
        },
        "operational_threshold": { "$ref": "#/$defs/decision_threshold" },
        "operational_prediction_available": {
          "type": "boolean"
        },
        "decision_basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "boundary_confirmations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "educational_threshold_automatically_promoted",
        "model_retrained",
        "model_reselected",
        "threshold_reoptimized_by_atlas",
        "source_run_mutated",
        "source_candidate_mutated",
        "source_inference_bundle_mutated",
        "promotion_invoked",
        "registry_mutated"
      ],
      "properties": {
        "educational_threshold_automatically_promoted": { "type": "boolean", "const": false },
        "model_retrained": { "type": "boolean", "const": false },
        "model_reselected": { "type": "boolean", "const": false },
        "threshold_reoptimized_by_atlas": { "type": "boolean", "const": false },
        "source_run_mutated": { "type": "boolean", "const": false },
        "source_candidate_mutated": { "type": "boolean", "const": false },
        "source_inference_bundle_mutated": { "type": "boolean", "const": false },
        "promotion_invoked": { "type": "boolean", "const": false },
        "registry_mutated": { "type": "boolean", "const": false }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "safe_relative_reference": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[^\\s].*$"
    },
    "artifact_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/safe_relative_reference" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "source_threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {
        "status": { "type": "string", "enum": ["resolved", "unresolved"] },
        "value": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "unresolved" } }, "required": ["status"] },
          "then": { "properties": { "value": { "const": null } } }
        },
        {
          "if": { "properties": { "status": { "const": "resolved" } }, "required": ["status"] },
          "then": { "properties": { "value": { "type": "number" } } }
        }
      ]
    },
    "decision_threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "selection_basis"],
      "description": "status = resolved requires a numeric value in [0,1] and a non-empty selection_basis; status = unresolved requires value = null and forbids a non-null selection_basis.",
      "properties": {
        "status": { "type": "string", "enum": ["resolved", "unresolved"] },
        "value": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "selection_basis": { "type": ["string", "null"], "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "unresolved" } }, "required": ["status"] },
          "then": { "properties": { "value": { "const": null }, "selection_basis": { "const": null } } }
        },
        {
          "if": { "properties": { "status": { "const": "resolved" } }, "required": ["status"] },
          "then": {
            "properties": { "value": { "type": "number" }, "selection_basis": { "type": "string", "minLength": 1 } },
            "required": ["value", "selection_basis"]
          }
        }
      ]
    }
  }
}
