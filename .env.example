# Atlas DataFlow — Environment Configuration Template
# Copy this file to .env and fill in the values for your deployment.
# IMPORTANT: Never commit .env or any file containing real values to the repository.
#
# Operator flow:
#   cp .env.example .env
#   # Edit .env and replace placeholder values with real operator-specific values
#   docker compose -f docker-compose.prod.yml --env-file .env up

# ─── API Service ──────────────────────────────────────────────────────────────

# Host interface the API binds to inside the container.
# Keep 0.0.0.0 to listen on all interfaces inside the container.
API_HOST=0.0.0.0

# Port the API listens on inside the container.
API_PORT=8000

# Absolute path to the releases directory on the host.
# Required only if the releases/ directory is not at the repository root.
# Example: RELEASES_ROOT=/opt/atlas-dataflow/releases
# RELEASES_ROOT=/path/to/releases

# ─── Web Frontend ─────────────────────────────────────────────────────────────

# Base URL for the frontend API client.
# Development: the API address reachable from the browser (e.g., http://localhost:8000).
# Production:  baked at build time as /api for same-origin proxy routing — not a runtime secret.
# WARNING: VITE_ variables are embedded in built static assets and are publicly visible.
#          Do not assign secrets, tokens, or passwords to any VITE_ variable.
VITE_API_BASE_URL=http://localhost:8000

# ─── Proxy (Caddy) ────────────────────────────────────────────────────────────

# The current Caddyfile (from M8-03) uses Caddy internal/self-signed TLS (tls internal)
# for local validation. No external domain or certificate path variables are consumed
# by the current configuration.
#
# For internet-facing production deployment with a real public domain and certificate,
# update the Caddyfile to reference your domain and certificate source, then document
# the required variables here.
# Example (not active): DOMAIN=your-domain.com
