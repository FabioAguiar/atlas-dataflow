{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-dataflow.local/schemas/pipeline/training-metrics.schema.json",
  "title": "Atlas DataFlow Training Metrics Artifact",
  "description": "Reduced metrics artifact emitted by a governed M24 training run at pipeline/training-runs/{dataset_slug}/{run_id}/metrics.json. Values are computed from the controlled evaluation split only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "created_at",
    "training_run_identity",
    "metric_source",
    "metrics",
    "path_references",
    "hashes",
    "evidence_policy"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "training-metrics.v1"
    },
    "artifact_kind": {
      "type": "string",
      "const": "training_metrics"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "training_run_identity": {
      "$ref": "#/$defs/training_run_identity"
    },
    "metric_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "split_name",
        "split_size",
        "random_seed",
        "computed_from_training_split",
        "computed_from_mixed_split"
      ],
      "properties": {
        "split_name": {
          "type": "string",
          "const": "evaluation"
        },
        "split_size": {
          "type": "integer",
          "minimum": 1
        },
        "random_seed": {
          "type": ["integer", "null"]
        },
        "computed_from_training_split": {
          "type": "boolean",
          "const": false
        },
        "computed_from_mixed_split": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_metric",
        "secondary_metrics"
      ],
      "properties": {
        "primary_metric": {
          "$ref": "#/$defs/metric_value"
        },
        "secondary_metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric_value"
          }
        }
      }
    },
    "path_references": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metrics_path",
        "training_parameter_record_path",
        "execution_contract_path",
        "dataset_path"
      ],
      "properties": {
        "metrics_path": {
          "$ref": "#/$defs/metrics_path"
        },
        "training_parameter_record_path": {
          "$ref": "#/$defs/training_parameter_record_path"
        },
        "execution_contract_path": {
          "type": "string",
          "minLength": 1
        },
        "dataset_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "execution_contract_sha256"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "execution_contract_sha256": {
          "$ref": "#/$defs/sha256_hex"
        }
      }
    },
    "evidence_policy": {
      "$ref": "#/$defs/evidence_policy"
    }
  },
  "$defs": {
    "training_run_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_slug",
        "run_id",
        "output_directory"
      ],
      "properties": {
        "dataset_slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^train-[0-9]{8}T[0-9]{6}Z$"
        },
        "output_directory": {
          "type": "string",
          "pattern": "^pipeline/training-runs/[a-z0-9]+(?:-[a-z0-9]+)*/train-[0-9]{8}T[0-9]{6}Z/$"
        }
      }
    },
    "metric_name": {
      "type": "string",
      "enum": [
        "roc_auc",
        "f1",
        "accuracy",
        "log_loss",
        "pr_auc"
      ]
    },
    "metric_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/metric_name"
        },
        "value": {
          "type": "number"
        }
      }
    },
    "metrics_path": {
      "type": "string",
      "pattern": "^pipeline/training-runs/[a-z0-9]+(?:-[a-z0-9]+)*/train-[0-9]{8}T[0-9]{6}Z/metrics\\.json$"
    },
    "training_parameter_record_path": {
      "type": "string",
      "pattern": "^pipeline/training-runs/[a-z0-9]+(?:-[a-z0-9]+)*/train-[0-9]{8}T[0-9]{6}Z/training-parameter-record\\.json$"
    },
    "sha256_hex": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_logs_prohibited",
        "raw_runtime_prohibited",
        "raw_api_payloads_prohibited",
        "secrets_prohibited",
        "raw_dataset_embedded",
        "model_bytes_embedded",
        "notebook_state_embedded",
        "reduced_and_sanitized"
      ],
      "properties": {
        "raw_logs_prohibited": {
          "type": "boolean",
          "const": true
        },
        "raw_runtime_prohibited": {
          "type": "boolean",
          "const": true
        },
        "raw_api_payloads_prohibited": {
          "type": "boolean",
          "const": true
        },
        "secrets_prohibited": {
          "type": "boolean",
          "const": true
        },
        "raw_dataset_embedded": {
          "type": "boolean",
          "const": false
        },
        "model_bytes_embedded": {
          "type": "boolean",
          "const": false
        },
        "notebook_state_embedded": {
          "type": "boolean",
          "const": false
        },
        "reduced_and_sanitized": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
