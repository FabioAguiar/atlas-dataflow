{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-dataflow.local/schemas/pipeline/scientific-study-contract.v2.schema.json",
  "title": "Atlas DataFlow Scientific Study Contract v2",
  "description": "Versioned representation of one revision of an external Dataset Study's scientific protocol and of the evidence that revision published. v2 generalizes v1 (binary only) to binary and multiclass classification: the problem type decides, through conditional rules, which concepts are required, allowed, or explicitly not applicable (positive class, threshold policy, class orders, decision rule). It adds technical row-occurrence partition membership, protocol gates (membership and final-fit row count), a family shortlist, a feature-policy selection stage, interpretive evidence, a pinned canonical-run artifact, a runtime-identity evidence group, and a protocol-integrity record. v1 contracts stay valid under the v1 schema and are never rewritten. A contract is immutable per study revision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "study_identity",
    "source_repository",
    "dataset_identity",
    "scientific_environment",
    "problem",
    "features",
    "preparation",
    "split",
    "preprocessing",
    "cross_validation",
    "metrics",
    "candidates",
    "selection",
    "threshold_policy",
    "final_evaluation",
    "tolerance_policy",
    "expected_evidence",
    "evidence_gaps",
    "protocol_integrity",
    "limitations",
    "authoring"
  ],
  "properties": {
    "schema_version": {
      "const": "scientific-study-contract.v2"
    },
    "artifact_kind": {
      "const": "scientific_study_contract"
    },
    "study_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_id",
        "dataset_slug",
        "protocol_kind",
        "study_revision_label"
      ],
      "properties": {
        "study_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "protocol_kind": {
          "type": "string",
          "minLength": 1
        },
        "study_revision_label": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        }
      }
    },
    "source_repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "revision",
        "pinned_files"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "revision_committed_at": {
          "type": "string"
        },
        "pinned_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "role"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/relative_path"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "role": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "canonical_run": {
      "description": "The study's structured canonical-run artifact from which expected evidence is derived by JSON pointer. It must also be listed in source_repository.pinned_files.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "schema_version"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "schema_version": {
          "type": "string"
        },
        "artifact_type": {
          "type": "string"
        }
      }
    },
    "dataset_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_name",
        "sha256",
        "size_bytes",
        "row_count",
        "column_count",
        "read_format",
        "atlas_local_path"
      ],
      "properties": {
        "source_provider": {
          "type": "string"
        },
        "source_reference": {
          "type": "string"
        },
        "file_name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "row_count": {
          "type": "integer",
          "minimum": 1
        },
        "column_count": {
          "type": "integer",
          "minimum": 1
        },
        "read_format": {
          "enum": [
            "csv"
          ]
        },
        "read_options": {
          "type": "object"
        },
        "atlas_local_path": {
          "$ref": "#/$defs/relative_path"
        },
        "study_source_contract_path": {
          "$ref": "#/$defs/relative_path"
        },
        "acquisition_note": {
          "type": "string"
        }
      }
    },
    "scientific_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "core_packages",
        "lock",
        "compatibility_policy"
      ],
      "properties": {
        "python": {
          "type": "string"
        },
        "implementation": {
          "type": "string"
        },
        "platform": {
          "type": [
            "string",
            "null"
          ]
        },
        "core_packages": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "lock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "format"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/relative_path"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "format": {
              "type": "string"
            },
            "python_version_file": {
              "$ref": "#/$defs/relative_path"
            },
            "python_version_file_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "compatibility_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "python": {
              "enum": [
                "exact",
                "same_minor",
                "same_major"
              ]
            },
            "core_packages": {
              "enum": [
                "exact",
                "same_minor",
                "same_major"
              ]
            },
            "platform": {
              "enum": [
                "difference_is_compatible",
                "difference_is_incompatible"
              ]
            },
            "rationale": {
              "type": "string"
            }
          }
        }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_type",
        "target",
        "decision_rule",
        "identifier_columns"
      ],
      "properties": {
        "problem_type": {
          "enum": [
            "binary_classification",
            "multiclass_classification"
          ]
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "column",
            "classes",
            "positive_class"
          ],
          "properties": {
            "column": {
              "type": "string",
              "minLength": 1
            },
            "classes": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true
            },
            "semantics": {
              "type": "string"
            },
            "label_representation": {
              "enum": [
                "encoded_integers",
                "string_labels"
              ]
            },
            "encoding": {
              "type": "object"
            },
            "positive_class": {
              "description": "A class label for binary problems; an explicit not-applicable record (never null, never an arbitrary class) for multiclass problems.",
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "$ref": "#/$defs/not_applicable"
                }
              ]
            },
            "estimator_class_order": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true
            },
            "public_class_order": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true
            }
          }
        },
        "decision_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "probability_threshold",
                "argmax_class_probability"
              ]
            },
            "study_label": {
              "type": "string"
            },
            "tie_resolution": {
              "enum": [
                "first_in_public_class_order",
                "first_in_estimator_class_order"
              ]
            },
            "rationale": {
              "type": "string"
            }
          }
        },
        "identifier_columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "problem_type": {
                "const": "binary_classification"
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "required": [
                  "encoding"
                ],
                "properties": {
                  "positive_class": {
                    "type": "string"
                  },
                  "classes": {
                    "maxItems": 2
                  }
                }
              },
              "decision_rule": {
                "properties": {
                  "kind": {
                    "const": "probability_threshold"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "problem_type": {
                "const": "multiclass_classification"
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "required": [
                  "estimator_class_order",
                  "public_class_order",
                  "label_representation"
                ],
                "properties": {
                  "positive_class": {
                    "$ref": "#/$defs/not_applicable"
                  },
                  "classes": {
                    "minItems": 3
                  },
                  "label_representation": {
                    "const": "string_labels"
                  }
                }
              },
              "decision_rule": {
                "required": [
                  "tie_resolution"
                ],
                "properties": {
                  "kind": {
                    "const": "argmax_class_probability"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_columns",
        "numerical",
        "categorical"
      ],
      "properties": {
        "feature_columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "numerical": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "categorical": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules",
        "row_removal"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/kind_object"
          }
        },
        "row_removal": {
          "enum": [
            "none",
            "declared_rules_only"
          ]
        }
      }
    },
    "split": {
      "type": "object",
      "required": [
        "kind",
        "membership",
        "fractions",
        "stratify_by",
        "seeds"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "membership": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "digest_order"
          ],
          "properties": {
            "kind": {
              "enum": [
                "identifier",
                "technical_row_occurrence"
              ]
            },
            "digest_order": {
              "enum": [
                "sorted_keys",
                "source_position"
              ]
            },
            "semantics": {
              "type": "string"
            }
          }
        },
        "fractions": {
          "type": "object",
          "required": [
            "train",
            "validation",
            "test"
          ],
          "properties": {
            "train": {
              "type": "number"
            },
            "validation": {
              "type": "number"
            },
            "test": {
              "type": "number"
            }
          }
        },
        "stratify_by": {
          "type": "string"
        },
        "shuffle": {
          "type": "boolean"
        },
        "seeds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "train_vs_temporary",
            "validation_vs_test"
          ],
          "properties": {
            "train_vs_temporary": {
              "type": "integer"
            },
            "validation_vs_test": {
              "type": "integer"
            }
          }
        },
        "partition_handoff": {
          "oneOf": [
            {
              "enum": [
                "csv_roundtrip",
                "in_memory"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "csv_roundtrip",
                    "in_memory"
                  ]
                },
                "float_format": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "partition_fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "csv_bytes_sha256"
            },
            "float_format": {
              "type": "string"
            }
          }
        },
        "membership_gate": {
          "description": "Protocol precondition, not a reproduced result: execution stops before any model is fitted when an observed membership digest differs.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "expected_membership_sha256",
            "source"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "expected_membership_sha256": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "train",
                "validation",
                "test"
              ],
              "properties": {
                "train": {
                  "$ref": "#/$defs/sha256"
                },
                "validation": {
                  "$ref": "#/$defs/sha256"
                },
                "test": {
                  "$ref": "#/$defs/sha256"
                }
              }
            },
            "source": {
              "$ref": "#/$defs/source"
            }
          }
        }
      }
    },
    "preprocessing": {
      "$ref": "#/$defs/kind_object"
    },
    "cross_validation": {
      "$ref": "#/$defs/kind_object"
    },
    "metrics": {
      "type": "object",
      "required": [
        "primary",
        "evaluated"
      ],
      "properties": {
        "primary": {
          "type": "string"
        },
        "refit": {
          "type": "string"
        },
        "evaluated": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cv_scorers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default_threshold": {
          "type": "number"
        },
        "definitions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "baseline": {
      "$ref": "#/$defs/candidate"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "search_execution": {
      "type": "object"
    },
    "family_shortlist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "metric",
        "k"
      ],
      "properties": {
        "kind": {
          "const": "top_k_by_cv_metric"
        },
        "metric": {
          "type": "string"
        },
        "k": {
          "type": "integer",
          "minimum": 1
        },
        "direction": {
          "enum": [
            "max",
            "min"
          ]
        },
        "tie_order": {
          "const": "model_id"
        },
        "source_partition": {
          "const": "train_cross_validation"
        }
      }
    },
    "feature_policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "candidate_id_pattern",
        "policies"
      ],
      "properties": {
        "kind": {
          "const": "frozen_family_params_feature_projection"
        },
        "candidate_id_pattern": {
          "const": "{model_id}__{policy_id}"
        },
        "applies_to": {
          "const": "family_shortlist"
        },
        "evaluation": {
          "type": "object"
        },
        "evidence_scope": {
          "type": "string"
        },
        "policies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "policy_id",
              "exclude"
            ],
            "properties": {
              "policy_id": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "exclude": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "derivation": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "selection": {
      "$ref": "#/$defs/kind_object"
    },
    "threshold_policy": {
      "description": "A binary threshold rule, or an explicit not-applicable record. Null or an artificial value is never allowed.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "partition"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "not": {
                "const": "not_applicable"
              }
            },
            "partition": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "applicable",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "not_applicable"
            },
            "applicable": {
              "const": false
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "final_evaluation": {
      "type": "object",
      "required": [
        "kind",
        "fit_partitions",
        "evaluation_partition",
        "evaluation_count"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "fit_partitions": {
          "type": "array",
          "items": {
            "enum": [
              "train",
              "validation"
            ]
          }
        },
        "fit_row_order": {
          "type": "string"
        },
        "evaluation_partition": {
          "const": "test"
        },
        "evaluation_count": {
          "const": 1
        },
        "fit_row_count_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expected_rows",
            "source"
          ],
          "properties": {
            "expected_rows": {
              "type": "integer",
              "minimum": 1
            },
            "source": {
              "$ref": "#/$defs/source"
            }
          }
        }
      }
    },
    "interpretive_evidence": {
      "description": "Descriptive evidence reproduced for comparison only; it never controls selection.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "confusion_pairs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "top_k"
          ],
          "properties": {
            "top_k": {
              "type": "integer",
              "minimum": 1
            },
            "focal_pairs": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2
              }
            },
            "focal_pairs_provenance": {
              "type": "string"
            }
          }
        },
        "repeated_profile_sensitivity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reference_partitions"
          ],
          "properties": {
            "kind": {
              "const": "non_destructive_repeated_feature_profile_sensitivity"
            },
            "reference_partitions": {
              "type": "array",
              "items": {
                "enum": [
                  "train",
                  "validation"
                ]
              }
            },
            "interpretation": {
              "type": "string"
            }
          }
        }
      }
    },
    "tolerance_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numeric_absolute",
        "count_absolute",
        "rationale"
      ],
      "properties": {
        "numeric_absolute": {
          "type": "number",
          "minimum": 0
        },
        "count_absolute": {
          "type": "integer",
          "minimum": 0
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "declared_before_first_reproduction": {
          "type": "boolean"
        },
        "exact_elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "expected_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values",
        "decisions"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expected_value"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expected_value"
          }
        },
        "runtime_identity": {
          "description": "Byte-level identity of runtime outputs (e.g. probability-matrix bytes). Compared and reported, but a difference distinguishes 'byte-identical runtime' from 'same scientific protocol' and never makes a reproduction divergent.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/expected_value"
          }
        }
      }
    },
    "evidence_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gap_id",
          "severity",
          "description"
        ],
        "properties": {
          "gap_id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "blocking",
              "informational"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "protocol_integrity": {
      "description": "What the study itself records about the isolation of its evaluation partitions. Procedural isolation of the corrected canonical run is kept distinct from historical exposure.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_procedurally_isolated_in_canonical_run",
        "historical_test_exposure",
        "statement"
      ],
      "properties": {
        "test_procedurally_isolated_in_canonical_run": {
          "type": "boolean"
        },
        "historical_test_exposure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exposed",
            "description"
          ],
          "properties": {
            "exposed": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            },
            "superseded_reference_status": {
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/source"
            }
          }
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "study_observations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authored_by",
        "authored_at",
        "method"
      ],
      "properties": {
        "authored_by": {
          "type": "string"
        },
        "authored_at": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "draft_path": {
          "$ref": "#/$defs/relative_path"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "protocol_parameter_sources": {
      "description": "Declared protocol inputs re-checked against the study's pinned structured artifact by verify_against_study_checkout.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_pointer",
          "source"
        ],
        "properties": {
          "contract_pointer": {
            "type": "string",
            "pattern": "^/"
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "problem": {
            "properties": {
              "problem_type": {
                "const": "multiclass_classification"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "threshold_policy": {
            "required": [
              "applicable"
            ],
            "properties": {
              "kind": {
                "const": "not_applicable"
              }
            }
          },
          "metrics": {
            "not": {
              "required": [
                "default_threshold"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "problem": {
            "properties": {
              "problem_type": {
                "const": "binary_classification"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "threshold_policy": {
            "properties": {
              "kind": {
                "not": {
                  "const": "not_applicable"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "feature_policies"
        ]
      },
      "then": {
        "required": [
          "family_shortlist"
        ]
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "(^|/)\\.\\.(/|$)"
          },
          {
            "pattern": "^[A-Za-z]:"
          }
        ]
      }
    },
    "not_applicable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable",
        "reason"
      ],
      "properties": {
        "applicable": {
          "const": false
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "kind_object": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "locator",
        "rendered_text"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "rendered_text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "family",
        "fixed_params",
        "numerical_scaling",
        "search"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "family": {
          "type": "string"
        },
        "study_estimator_class": {
          "type": "string"
        },
        "fixed_params": {
          "type": "object"
        },
        "numerical_scaling": {
          "enum": [
            "standard",
            "passthrough"
          ]
        },
        "search": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "grid",
                "randomized",
                "none"
              ]
            },
            "space": {
              "type": "object"
            },
            "n_iter": {
              "type": "integer",
              "minimum": 1
            },
            "random_state": {
              "type": "integer"
            },
            "expected_candidate_count": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "eligible_for_selection": {
          "type": "boolean"
        }
      }
    },
    "expected_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quantity",
        "expected",
        "comparison",
        "source"
      ],
      "properties": {
        "quantity": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(\\.[A-Za-z0-9_]+)*$"
        },
        "expected": {},
        "comparison": {
          "enum": [
            "numeric",
            "count",
            "exact"
          ]
        },
        "reported_decimal_places": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    }
  }
}
