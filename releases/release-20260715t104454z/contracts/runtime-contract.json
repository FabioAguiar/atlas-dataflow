      "type": "categorical",
      "required": true,
      "domain_constraints": {
        "values": [
          "No",
          "No internet service",
          "Yes"
        ]
      }
    },
    {
      "name": "DeviceProtection",
      "type": "categorical",
      "required": true,
      "domain_constraints": {
        "values": [
          "No",
          "No internet service",
          "Yes"
        ]
      }
    },
    {
      "name": "TechSupport",
      "type": "categorical",
      "required": true,
      "domain_constraints": {
        "values": [
          "No",
          "No internet service",
          "Yes"
        ]
      }
    },
    {
      "name": "StreamingTV",
      "type": "categorical",
      "required": true,
      "domain_constraints": {
        "values": [
          "No",
          "No internet service",
          "Yes"
        ]
      }
    },
    {
      "name": "StreamingMovies",
      "type": "categorical",
      "required": true,
      "domain_constraints": {
        "values": [
          "No",
          "No internet service",
          "Yes"
        ]
      }
