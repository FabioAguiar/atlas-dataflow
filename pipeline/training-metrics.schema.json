{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-dataflow.local/schemas/pipeline/training-metrics.schema.json",
  "title": "Atlas DataFlow Training Metrics Artifact",
  "description": "Reduced metrics artifact. Two schema-version-discriminated profiles are supported: training-metrics.v1 (unchanged, emitted by a governed M24 training run at pipeline/training-runs/{dataset_slug}/{run_id}/metrics.json, computed from the controlled evaluation split only) and training-metrics.external-fitted-model.v1 (Project Spec S0157, produced by a validated external handoff/projection flow, distinguishing cross-validation, validation, and final-test partition roles).",
  "type": "object",
  "required": ["schema_version"],
  "oneOf": [
    { "$ref": "#/$defs/internal_run_metrics_v1" },
    { "$ref": "#/$defs/external_metrics_v1" },
    { "$ref": "#/$defs/external_metrics_v2" }
  ],
  "$defs": {
    "internal_run_metrics_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_kind",
        "created_at",
        "training_run_identity",
        "metric_source",
        "metrics",
        "path_references",
        "hashes",
        "evidence_policy"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "training-metrics.v1"
        },
        "artifact_kind": {
          "type": "string",
          "const": "training_metrics"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "training_run_identity": {
          "$ref": "#/$defs/training_run_identity"
        },
        "metric_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "split_name",
            "split_size",
            "random_seed",
            "computed_from_training_split",
            "computed_from_mixed_split"
          ],
          "properties": {
            "split_name": {
              "type": "string",
              "const": "evaluation"
            },
            "split_size": {
              "type": "integer",
              "minimum": 1
            },
            "random_seed": {
              "type": ["integer", "null"]
            },
            "computed_from_training_split": {
              "type": "boolean",
              "const": false
            },
            "computed_from_mixed_split": {
              "type": "boolean",
              "const": false
            }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary_metric",
            "secondary_metrics"
          ],
          "properties": {
            "primary_metric": {
              "$ref": "#/$defs/metric_value"
            },
            "secondary_metrics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/metric_value"
              }
            }
          }
        },
        "path_references": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metrics_path",
            "training_parameter_record_path",
            "execution_contract_path",
            "dataset_path"
          ],
          "properties": {
            "metrics_path": {
              "$ref": "#/$defs/metrics_path"
            },
            "training_parameter_record_path": {
              "$ref": "#/$defs/training_parameter_record_path"
            },
            "execution_contract_path": {
              "type": "string",
              "minLength": 1
            },
            "dataset_path": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "hashes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "execution_contract_sha256"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "sha256"
            },
            "execution_contract_sha256": {
              "$ref": "#/$defs/sha256_hex"
            }
          }
        },
        "evidence_policy": {
          "$ref": "#/$defs/evidence_policy"
        }
      }
    },
    "external_metrics_v1": {
      "type": "object",
      "additionalProperties": false,
      "description": "Project Spec S0157: external fitted-model metrics evidence by partition role. Metric values must be finite numbers -- enforced by validating code alongside this schema, since JSON Schema's 'number' type alone does not reject NaN/Infinity. No raw predictions, probabilities, row identifiers, or partition rows are embedded anywhere in this profile.",
      "required": [
        "schema_version",
        "artifact_kind",
        "created_at",
        "evidence_identity",
        "cross_validation_summary",
        "validation_evaluation"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "training-metrics.external-fitted-model.v1"
        },
        "artifact_kind": {
          "type": "string",
          "const": "training_metrics"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_source_mode", "dataset_slug"],
          "properties": {
            "model_source_mode": {
              "type": "string",
              "const": "validated_external_fitted_model"
            },
            "dataset_slug": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "cross_validation_summary": {
          "$ref": "#/$defs/cross_validation_partition"
        },
        "validation_evaluation": {
          "$ref": "#/$defs/validation_partition"
        },
        "final_test_evaluation": {
          "$ref": "#/$defs/final_test_partition"
        }
      }
    },
    "external_metrics_v2": {
      "type": "object",
      "additionalProperties": false,
      "description": "Project Spec S0215: v2 external fitted-model metrics evidence for multiclass classification, by partition role. Preserves every S0157/S0208 external scientific-evidence discipline, replacing the binary-era used_for_threshold_selection partition field with the semantically correct used_for_decision_rule_selection and requiring a governed multiclass classification_evidence claim. Metric values must be finite numbers -- enforced by validating code alongside this schema, since JSON Schema's 'number' type alone does not reject NaN/Infinity. No raw predictions, probabilities, row identifiers, or partition rows are embedded anywhere in this profile.",
      "required": [
        "schema_version",
        "artifact_kind",
        "created_at",
        "evidence_identity",
        "classification_evidence",
        "cross_validation_summary",
        "validation_evaluation"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "training-metrics.external-fitted-model.v2"
        },
        "artifact_kind": {
          "type": "string",
          "const": "training_metrics"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_source_mode", "dataset_slug"],
          "properties": {
            "model_source_mode": {
              "type": "string",
              "const": "validated_external_fitted_model"
            },
            "dataset_slug": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "classification_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["problem_type", "ordered_class_ids"],
          "properties": {
            "problem_type": {
              "type": "string",
              "const": "multiclass_classification"
            },
            "ordered_class_ids": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "cross_validation_summary": {
          "$ref": "#/$defs/multiclass_cross_validation_partition_v2"
        },
        "validation_evaluation": {
          "$ref": "#/$defs/multiclass_validation_partition_v2"
        },
        "final_test_evaluation": {
          "$ref": "#/$defs/multiclass_final_test_partition_v2"
        }
      }
    },
    "multiclass_cross_validation_partition_v2": {
      "type": "object",
      "additionalProperties": false,
      "description": "Cross-validation may only ever use the training partition.",
      "required": [
        "partition_role",
        "used_for_fitting",
        "used_for_model_selection",
        "used_for_decision_rule_selection",
        "used_for_adjustment",
        "sealed_before_finalization",
        "metrics"
      ],
      "properties": {
        "partition_role": { "type": "string", "const": "train" },
        "row_count": { "type": "integer", "minimum": 1 },
        "used_for_fitting": { "type": "boolean", "const": true },
        "used_for_model_selection": { "type": "boolean", "const": true },
        "used_for_decision_rule_selection": { "type": "boolean", "const": false },
        "used_for_adjustment": { "type": "boolean", "const": false },
        "sealed_before_finalization": { "type": "boolean", "const": false },
        "evaluation_count": { "type": "integer", "minimum": 1 },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/multiclass_metric_value_v2" }
        }
      }
    },
    "multiclass_validation_partition_v2": {
      "type": "object",
      "additionalProperties": false,
      "description": "Validation may be used for model selection. used_for_decision_rule_selection must be false for the first argmax decision-strategy capability.",
      "required": [
        "partition_role",
        "used_for_fitting",
        "used_for_model_selection",
        "used_for_decision_rule_selection",
        "sealed_before_finalization",
        "metrics"
      ],
      "properties": {
        "partition_role": { "type": "string", "const": "validation" },
        "row_count": { "type": "integer", "minimum": 1 },
        "used_for_fitting": { "type": "boolean", "const": false },
        "used_for_model_selection": { "type": "boolean" },
        "used_for_decision_rule_selection": { "type": "boolean", "const": false },
        "used_for_adjustment": { "type": "boolean" },
        "sealed_before_finalization": { "type": "boolean", "const": false },
        "evaluation_count": { "type": "integer", "minimum": 1 },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/multiclass_metric_value_v2" }
        },
        "per_class_metrics": {
          "type": "array",
          "items": { "$ref": "#/$defs/multiclass_per_class_metric" }
        }
      }
    },
    "multiclass_final_test_partition_v2": {
      "type": "object",
      "additionalProperties": false,
      "description": "Final test can never be used for fitting, model selection, or decision-rule selection, and must be sealed before finalization. evaluation_count is bounded to [0, 1] so more than one final-test evaluation is structurally rejected; a completed evaluation (completed: true) additionally requires evaluation_count to equal exactly 1.",
      "required": [
        "partition_role",
        "used_for_fitting",
        "used_for_model_selection",
        "used_for_decision_rule_selection",
        "used_for_adjustment",
        "sealed_before_finalization",
        "completed",
        "evaluation_count",
        "metrics"
      ],
      "properties": {
        "partition_role": { "type": "string", "const": "test" },
        "row_count": { "type": "integer", "minimum": 1 },
        "used_for_fitting": { "type": "boolean", "const": false },
        "used_for_model_selection": { "type": "boolean", "const": false },
        "used_for_decision_rule_selection": { "type": "boolean", "const": false },
        "used_for_adjustment": { "type": "boolean", "const": false },
        "sealed_before_finalization": { "type": "boolean", "const": true },
        "completed": { "type": "boolean" },
        "evaluation_count": { "type": "integer", "minimum": 0, "maximum": 1 },
        "metrics": {
          "type": "array",
          "items": { "$ref": "#/$defs/multiclass_metric_value_v2" }
        },
        "per_class_metrics": {
          "type": "array",
          "items": { "$ref": "#/$defs/multiclass_per_class_metric" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "completed": { "const": true } }, "required": ["completed"] },
          "then": {
            "properties": {
              "evaluation_count": { "const": 1 },
              "metrics": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "completed": { "const": false } }, "required": ["completed"] },
          "then": { "properties": { "evaluation_count": { "const": 0 } } }
        }
      ]
    },
    "multiclass_metric_name_v2": {
      "type": "string",
      "enum": [
        "accuracy",
        "balanced_accuracy",
        "f1_macro",
        "f1_weighted",
        "precision_macro",
        "recall_macro",
        "log_loss"
      ]
    },
    "multiclass_metric_value_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "$ref": "#/$defs/multiclass_metric_name_v2" },
        "value": { "type": "number" }
      }
    },
    "multiclass_per_class_metric": {
      "type": "object",
      "additionalProperties": false,
      "description": "Project Spec S0215: per-class evidence for one governed class. precision/recall/f1 are bounded to [0,1]; support is a non-negative row count. Class ordering/coverage against classification_evidence.ordered_class_ids is enforced defensively by validating code, not by this schema alone.",
      "required": ["class_id", "precision", "recall", "f1", "support"],
      "properties": {
        "class_id": { "type": "string", "minLength": 1 },
        "precision": { "type": "number", "minimum": 0, "maximum": 1 },
        "recall": { "type": "number", "minimum": 0, "maximum": 1 },
        "f1": { "type": "number", "minimum": 0, "maximum": 1 },
        "support": { "type": "integer", "minimum": 0 }
      }
    },
    "cross_validation_partition": {
      "type": "object",
      "additionalProperties": false,
      "description": "Cross-validation may only ever use the training partition.",
      "required": [
        "partition_role",
        "used_for_fitting",
        "used_for_model_selection",
        "used_for_threshold_selection",
        "used_for_adjustment",
        "sealed_before_finalization",
        "metrics"
      ],
      "properties": {
        "partition_role": { "type": "string", "const": "train" },
        "row_count": { "type": "integer", "minimum": 1 },
        "used_for_fitting": { "type": "boolean", "const": true },
        "used_for_model_selection": { "type": "boolean", "const": true },
        "used_for_threshold_selection": { "type": "boolean", "const": false },
        "used_for_adjustment": { "type": "boolean", "const": false },
        "sealed_before_finalization": { "type": "boolean", "const": false },
        "evaluation_count": { "type": "integer", "minimum": 1 },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/metric_value" }
        }
      }
    },
    "validation_partition": {
      "type": "object",
      "additionalProperties": false,
      "description": "Validation may be used for model selection and educational-threshold selection.",
      "required": [
        "partition_role",
        "used_for_fitting",
        "used_for_model_selection",
        "used_for_threshold_selection",
        "sealed_before_finalization",
        "metrics"
      ],
      "properties": {
        "partition_role": { "type": "string", "const": "validation" },
        "row_count": { "type": "integer", "minimum": 1 },
        "used_for_fitting": { "type": "boolean", "const": false },
        "used_for_model_selection": { "type": "boolean" },
        "used_for_threshold_selection": { "type": "boolean" },
        "used_for_adjustment": { "type": "boolean" },
        "sealed_before_finalization": { "type": "boolean", "const": false },
        "evaluation_count": { "type": "integer", "minimum": 1 },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/metric_value" }
        }
      }
    },
    "final_test_partition": {
      "type": "object",
      "additionalProperties": false,
      "description": "Final test can never be used for fitting, model selection, threshold selection, or adjustment, and must be sealed before finalization. evaluation_count is bounded to [0, 1] so more than one final-test evaluation is structurally rejected; a completed evaluation (completed: true) additionally requires evaluation_count to equal exactly 1.",
      "required": [
        "partition_role",
        "used_for_fitting",
        "used_for_model_selection",
        "used_for_threshold_selection",
        "used_for_adjustment",
        "sealed_before_finalization",
        "completed",
        "evaluation_count",
        "metrics"
      ],
      "properties": {
        "partition_role": { "type": "string", "const": "test" },
        "row_count": { "type": "integer", "minimum": 1 },
        "used_for_fitting": { "type": "boolean", "const": false },
        "used_for_model_selection": { "type": "boolean", "const": false },
        "used_for_threshold_selection": { "type": "boolean", "const": false },
        "used_for_adjustment": { "type": "boolean", "const": false },
        "sealed_before_finalization": { "type": "boolean", "const": true },
        "completed": { "type": "boolean" },
        "evaluation_count": { "type": "integer", "minimum": 0, "maximum": 1 },
        "metrics": {
          "type": "array",
          "items": { "$ref": "#/$defs/metric_value" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "completed": { "const": true } }, "required": ["completed"] },
          "then": {
            "properties": {
              "evaluation_count": { "const": 1 },
              "metrics": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "completed": { "const": false } }, "required": ["completed"] },
          "then": { "properties": { "evaluation_count": { "const": 0 } } }
        }
      ]
    },
    "training_run_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_slug",
        "run_id",
        "output_directory"
      ],
      "properties": {
        "dataset_slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^train-[0-9]{8}T[0-9]{6}Z$"
        },
        "output_directory": {
          "type": "string",
          "pattern": "^pipeline/training-runs/[a-z0-9]+(?:-[a-z0-9]+)*/train-[0-9]{8}T[0-9]{6}Z/$"
        }
      }
    },
    "metric_name": {
      "type": "string",
      "enum": [
        "roc_auc",
        "f1",
        "accuracy",
        "log_loss",
        "pr_auc",
        "average_precision",
        "precision",
        "recall",
        "f2",
        "balanced_accuracy",
        "brier_score"
      ]
    },
    "metric_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/metric_name"
        },
        "value": {
          "type": "number"
        }
      }
    },
    "metrics_path": {
      "type": "string",
      "pattern": "^pipeline/training-runs/[a-z0-9]+(?:-[a-z0-9]+)*/train-[0-9]{8}T[0-9]{6}Z/metrics\\.json$"
    },
    "training_parameter_record_path": {
      "type": "string",
      "pattern": "^pipeline/training-runs/[a-z0-9]+(?:-[a-z0-9]+)*/train-[0-9]{8}T[0-9]{6}Z/training-parameter-record\\.json$"
    },
    "sha256_hex": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_logs_prohibited",
        "raw_runtime_prohibited",
        "raw_api_payloads_prohibited",
        "secrets_prohibited",
        "raw_dataset_embedded",
        "model_bytes_embedded",
        "notebook_state_embedded",
        "reduced_and_sanitized"
      ],
      "properties": {
        "raw_logs_prohibited": {
          "type": "boolean",
          "const": true
        },
        "raw_runtime_prohibited": {
          "type": "boolean",
          "const": true
        },
        "raw_api_payloads_prohibited": {
          "type": "boolean",
          "const": true
        },
        "secrets_prohibited": {
          "type": "boolean",
          "const": true
        },
        "raw_dataset_embedded": {
          "type": "boolean",
          "const": false
        },
        "model_bytes_embedded": {
          "type": "boolean",
          "const": false
        },
        "notebook_state_embedded": {
          "type": "boolean",
          "const": false
        },
        "reduced_and_sanitized": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
