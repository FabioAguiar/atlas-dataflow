# Atlas DataFlow — Environment Configuration Template
# Copy this file to .env and fill in the values for your deployment.
# IMPORTANT: Never commit .env or any file containing real values to the repository.
#
# Operator flow:
#   cp .env.example .env
#   # Edit .env and replace placeholder values with real operator-specific values
#   docker compose -f docker-compose.prod.yml --env-file .env up

# ─── API Service ──────────────────────────────────────────────────────────────

# Host interface the API binds to inside the container.
# Keep 0.0.0.0 to listen on all interfaces inside the container.
API_HOST=0.0.0.0

# Port the API listens on inside the container.
API_PORT=8000

# Absolute path to the releases directory on the host.
# Required only if the releases/ directory is not at the repository root.
# Example: RELEASES_ROOT=/opt/atlas-dataflow/releases
# RELEASES_ROOT=/path/to/releases

# ─── Web Frontend ─────────────────────────────────────────────────────────────

# Base URL for the frontend API client.
# Development: the API address reachable from the browser (e.g., http://localhost:8000).
# Production:  baked at build time as /api for same-origin proxy routing — not a runtime secret.
# WARNING: VITE_ variables are embedded in built static assets and are publicly visible.
#          Do not assign secrets, tokens, or passwords to any VITE_ variable.
VITE_API_BASE_URL=http://localhost:8000

# ─── Supabase integration (Atlas-specific project/stack per environment) ─────
# Atlas DEV pairs with the Atlas DEV Supabase stack, Atlas PROD with the PROD
# stack (hosted or self-hosted). Use different values per environment.
# Classes: [publishable] inlined into the public web bundle; [trusted] backend
# configuration, not secret but never in the web build; [secret] never commit,
# never in a VITE_ variable, never in a build arg.

# [publishable] Browser-visible Supabase origin (DEV: SSH-forwarded localhost).
VITE_SUPABASE_URL=<supabase-project-url>
# [publishable] Supabase publishable (anon) key. Never the service_role/secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# [publishable flag] true only for the private Admin build; false for public.
VITE_ENABLE_ADMIN=false

# --- Atlas API (backend only) ---
# [trusted] Private runtime Admin mode; keep false on the public deployment.
ATLAS_ADMIN_ENABLED=false
# [trusted] Exact browser-visible token issuer, e.g. <supabase-project-url>/auth/v1
ATLAS_SUPABASE_JWT_ISSUER=<supabase-jwt-issuer>
ATLAS_SUPABASE_JWT_AUDIENCE=authenticated
# [trusted] JWKS key-fetch address the API container can reach. Independent of
# the issuer. https unless the private-HTTP opt-in below is "true".
ATLAS_SUPABASE_JWKS_URL=<supabase-jwks-url>
# [trusted] DEV/self-hosted only: "true" permits plain http to loopback,
# RFC1918, IPv6 ULA/loopback or single-label service hosts on the dedicated
# trusted Docker network. Default false.
ATLAS_SUPABASE_JWKS_ALLOW_PRIVATE_HTTP=false
# [trusted] UUID of the single provisioned Admin operator.
ATLAS_ADMIN_USER_ID=<atlas-admin-user-uuid>
# [secret] Shared gateway credential; must equal the Edge Function's
# ATLAS_GATEWAY_TOKEN. Distinct per environment.
ATLAS_INFERENCE_GATEWAY_TOKEN=<set-in-deployment>

# --- Edge Function secrets (set in the Supabase stack, NOT in this .env) ---
# Listed for reference; they configure supabase/functions/inference-gateway.
# ATLAS_GATEWAY_TOKEN=<set-in-deployment>                 [secret]
# ATLAS_GATEWAY_BASE_URL=<atlas-api-base-url>             [trusted] public: https://<host>/api ; private hop: http://<api-alias>:8000 (no /api)
# ATLAS_GATEWAY_ALLOW_PRIVATE_HTTP=false                  [trusted] "true" only on the dedicated trusted network
# ATLAS_GATEWAY_ALLOWED_ORIGINS=<web-origin>              [trusted] exact origins, no wildcard
# ATLAS_SUPABASE_JWT_ISSUER=<supabase-jwt-issuer>         [trusted] optional; defaults to <SUPABASE_URL>/auth/v1
# ATLAS_SUPABASE_JWKS_URL=<supabase-jwks-url>             [trusted] optional; defaults from SUPABASE_URL

# --- Optional shared private network (docker-compose.self-hosted-network.yml) ---
# [DEV/PROD-specific] Applies only when that override file is layered on.
# ATLAS_SUPABASE_SHARED_NETWORK=<shared-docker-network-name>
# ATLAS_PRIVATE_API_ALIAS=<environment-unique-api-alias>   # e.g. atlas-dataflow-dev-api, never "api"

# ─── Proxy (Caddy) ────────────────────────────────────────────────────────────

# The current Caddyfile (from M8-03) uses Caddy internal/self-signed TLS (tls internal)
# for local validation. No external domain or certificate path variables are consumed
# by the current configuration.
#
# For internet-facing production deployment with a real public domain and certificate,
# update the Caddyfile to reference your domain and certificate source, then document
# the required variables here.
# Example (not active): DOMAIN=your-domain.com
