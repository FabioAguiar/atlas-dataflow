{
  "schema_version": "1.0.0",
  "features": [
    {
      "name": "gender",
      "type": "categorical",
      "required": true,
      "domain_constraints": {
        "values": [
          "Female",
          "Male"
        ]
      }
    },
    {
      "name": "SeniorCitizen",
      "type": "boolean",
      "required": true
    },
    {
