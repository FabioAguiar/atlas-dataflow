{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-dataflow.local/schemas/published-dataset-registry.v1",
  "title": "Atlas DataFlow Published Dataset Registry",
  "description": "Minimum file-based registry contract for the first public cycle. The registry declares published datasets, their explicit active releases, and safe public metadata. It does not define release package contents or runtime resolution behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "conventions",
    "datasets"
  ],
  "properties": {
    "schema_version": {
      "const": "atlas.dataflow.registry.v1"
    },
    "conventions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_slug",
        "release_id",
        "active_release"
      ],
      "properties": {
        "dataset_slug": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pattern",
            "description"
          ],
          "properties": {
            "pattern": {
              "const": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "release_id": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pattern",
            "description"
          ],
          "properties": {
            "pattern": {
              "const": "^release-[0-9]{8}-[0-9]{3}$"
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "active_release": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "description"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dataset"
      }
    }
  },
  "$defs": {
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_slug",
        "active_release",
        "public_metadata"
      ],
      "properties": {
        "dataset_slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "active_release": {
          "type": "string",
          "pattern": "^release-[0-9]{8}-[0-9]{3}$"
        },
        "public_metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "summary",
            "domain",
            "visibility",
            "tags"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "domain": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "visibility": {
              "const": "public"
            },
            "tags": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "maxLength": 40
              },
              "uniqueItems": true
            }
          }
        }
      }
    }
  }
}
