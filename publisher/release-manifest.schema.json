{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-dataflow.local/schemas/publisher/release-manifest.schema.json",
  "title": "Atlas DataFlow Release Manifest",
  "description": "Internal publisher manifest contract for release composition and artifact hash traceability. This schema defines the minimum manifest shape; it does not calculate hashes, sign releases, migrate storage, load runtime artifacts, expose public endpoints, promote releases, update the registry, or publish to GitHub.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_kind",
    "dataset_identity",
    "release_identity",
    "artifacts",
    "required_hash_coverage",
    "validation_policy",
    "safety_boundaries"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "release-manifest.v1"
    },
    "manifest_kind": {
      "type": "string",
      "const": "release_manifest",
      "description": "Distinguishes this traceability manifest from a release candidate, registry entry, runtime contract, or promotion record."
    },
    "dataset_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_slug"
      ],
      "properties": {
        "dataset_slug": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Stable dataset identifier. It must be explicit and must not be inferred from a local path."
        },
        "dataset_title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "release_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "release_version"
      ],
      "properties": {
        "release_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[-._][a-z0-9]+)*$",
          "description": "Stable release identifier. It must be explicit and must not be inferred from a local path."
        },
        "release_version": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "promoted_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/artifact_entry"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "role": {
                "const": "contracts"
              }
            },
            "required": [
              "role"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "public_contract"
              }
            },
            "required": [
              "role"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "predictive_bundle"
              }
            },
            "required": [
              "role"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "model_artifact"
              }
            },
            "required": [
              "role"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "metrics"
              }
            },
            "required": [
              "role"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "model_card"
              }
            },
            "required": [
              "role"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "public_context"
              }
            },
            "required": [
              "role"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "visualizations"
              }
            },
            "required": [
              "role"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "manifest_input"
              }
            },
            "required": [
              "role"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "candidate_metadata"
              }
            },
            "required": [
              "role"
            ]
          }
        }
      ]
    },
    "required_hash_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash_algorithm",
        "required_artifact_roles",
        "missing_required_hashes_reject_manifest"
      ],
      "properties": {
        "hash_algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "required_artifact_roles": {
          "$ref": "#/$defs/required_artifact_role_list"
        },
        "missing_required_hashes_reject_manifest": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "validation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_schema_version_rejects",
        "missing_required_hash_rejects",
        "dataset_identity_mismatch_rejects",
        "release_identity_mismatch_rejects",
        "unsafe_reference_rejects"
      ],
      "properties": {
        "missing_schema_version_rejects": {
          "type": "boolean",
          "const": true
        },
        "missing_required_hash_rejects": {
          "type": "boolean",
          "const": true
        },
        "dataset_identity_mismatch_rejects": {
          "type": "boolean",
          "const": true
        },
        "release_identity_mismatch_rejects": {
          "type": "boolean",
          "const": true
        },
        "unsafe_reference_rejects": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "safety_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_artifact_contents_embedded",
        "raw_logs_persisted",
        "raw_runtime_persisted",
        "raw_api_payloads_persisted",
        "secrets_persisted",
        "sensitive_local_paths_persisted",
        "unstable_temporary_paths_persisted",
        "hash_calculation_implemented",
        "signing_or_key_management_implemented",
        "storage_migration_implemented",
        "runtime_loading_implemented",
        "public_endpoint_exposed",
        "release_promoted",
        "registry_updated",
        "github_publication_performed"
      ],
      "properties": {
        "raw_artifact_contents_embedded": {
          "type": "boolean",
          "const": false
        },
        "raw_logs_persisted": {
          "type": "boolean",
          "const": false
        },
        "raw_runtime_persisted": {
          "type": "boolean",
          "const": false
        },
        "raw_api_payloads_persisted": {
          "type": "boolean",
          "const": false
        },
        "secrets_persisted": {
          "type": "boolean",
          "const": false
        },
        "sensitive_local_paths_persisted": {
          "type": "boolean",
          "const": false
        },
        "unstable_temporary_paths_persisted": {
          "type": "boolean",
          "const": false
        },
        "hash_calculation_implemented": {
          "type": "boolean",
          "const": false
        },
        "signing_or_key_management_implemented": {
          "type": "boolean",
          "const": false
        },
        "storage_migration_implemented": {
          "type": "boolean",
          "const": false
        },
        "runtime_loading_implemented": {
          "type": "boolean",
          "const": false
        },
        "public_endpoint_exposed": {
          "type": "boolean",
          "const": false
        },
        "release_promoted": {
          "type": "boolean",
          "const": false
        },
        "registry_updated": {
          "type": "boolean",
          "const": false
        },
        "github_publication_performed": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "capability_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_profile_id",
        "capability_profile_version",
        "capability_profile_integrity",
        "resolved_artifact_role_inventory",
        "authoring_lineage"
      ],
      "description": "Project Spec S0168. Optional capability identity for a release governed by a capability profile, additive only (new optional property; existing required array unchanged). Absent for a historical release-manifest.v1 instance, which remains valid under its historical contract semantics. Carries only integrity-bound references and a resolved role inventory -- never the complete capability profile or authoring manifest payload.",
      "properties": {
        "capability_profile_id": {"$ref": "#/$defs/capability_identifier"},
        "capability_profile_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^v[0-9]+$"
        },
        "capability_profile_integrity": {
          "$ref": "#/$defs/integrity_reference",
          "description": "Hash reference to the governing capability profile document. Never the profile payload itself."
        },
        "resolved_artifact_role_inventory": {
          "type": "array",
          "minItems": 1,
          "description": "The resolved applicability (required/optional/forbidden) for every artifact role this release's capability profile governs.",
          "items": {"$ref": "#/$defs/manifest_role_policy_entry"}
        },
        "authoring_lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authoring_generation_id", "authoring_manifest_integrity"],
          "description": "Traceability to the immutable Atlas authoring generation this release was built from. Never embeds the authoring manifest payload.",
          "properties": {
            "authoring_generation_id": {"$ref": "#/$defs/identifier"},
            "authoring_manifest_integrity": {"$ref": "#/$defs/integrity_reference"}
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[-._][a-z0-9]+)*$"
    },
    "capability_identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "role_applicability": {
      "type": "string",
      "enum": ["required", "optional", "forbidden"]
    },
    "integrity_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash_algorithm", "hash_value"],
      "properties": {
        "hash_algorithm": {"type": "string", "const": "sha256"},
        "hash_value": {"$ref": "#/$defs/sha256"}
      }
    },
    "manifest_role_policy_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_name", "applicability"],
      "properties": {
        "role_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "applicability": {"$ref": "#/$defs/role_applicability"}
      }
    },
    "artifact_role": {
      "type": "string",
      "enum": [
        "contracts",
        "public_contract",
        "predictive_bundle",
        "model_artifact",
        "metrics",
        "model_card",
        "public_context",
        "visualizations",
        "manifest_input",
        "candidate_metadata",
        "release_manifest",
        "validation_evidence"
      ]
    },
    "required_artifact_role": {
      "type": "string",
      "enum": [
        "contracts",
        "public_contract",
        "predictive_bundle",
        "model_artifact",
        "metrics",
        "model_card",
        "public_context",
        "visualizations",
        "manifest_input",
        "candidate_metadata"
      ]
    },
    "required_artifact_role_list": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/required_artifact_role"
      },
      "allOf": [
        {
          "contains": {
            "const": "contracts"
          }
        },
        {
          "contains": {
            "const": "public_contract"
          }
        },
        {
          "contains": {
            "const": "predictive_bundle"
          }
        },
        {
          "contains": {
            "const": "model_artifact"
          }
        },
        {
          "contains": {
            "const": "metrics"
          }
        },
        {
          "contains": {
            "const": "model_card"
          }
        },
        {
          "contains": {
            "const": "public_context"
          }
        },
        {
          "contains": {
            "const": "visualizations"
          }
        },
        {
          "contains": {
            "const": "manifest_input"
          }
        },
        {
          "contains": {
            "const": "candidate_metadata"
          }
        }
      ]
    },
    "safe_relative_reference": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))(?!.*//)(?!.*\\\\)[^\\s].*$",
      "description": "Release-package-relative artifact reference. It must not be an absolute path, parent-directory traversal, Windows path, local temporary path, raw log path, or sensitive local-only path."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "reference",
        "hash_algorithm",
        "hash_value"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/artifact_role"
        },
        "reference": {
          "$ref": "#/$defs/safe_relative_reference"
        },
        "hash_algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "hash_value": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    }
  }
}
