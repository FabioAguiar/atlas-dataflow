{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-dataflow.local/schemas/pipeline/scientific-study-contract.schema.json",
  "title": "Atlas DataFlow Scientific Study Contract",
  "description": "Structured, versioned representation of one revision of an external Dataset Study's scientific protocol and of the evidence that revision published. The Dataset Study repository is the source of truth; this contract pins one revision (commit plus file hashes) so an Atlas scientific reproduction can execute the protocol independently and compare against the pinned reference evidence. A contract is immutable per study revision: a changed study produces a new contract directory, never an edit of an existing one. It is not an Atlas execution contract, release manifest, or training run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "study_identity",
    "source_repository",
    "dataset_identity",
    "scientific_environment",
    "problem",
    "features",
    "preparation",
    "split",
    "preprocessing",
    "cross_validation",
    "metrics",
    "candidates",
    "selection",
    "threshold_policy",
    "final_evaluation",
    "tolerance_policy",
    "expected_evidence",
    "evidence_gaps",
    "limitations",
    "authoring"
  ],
  "properties": {
    "schema_version": { "const": "scientific-study-contract.v1" },
    "artifact_kind": { "const": "scientific_study_contract" },
    "study_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["study_id", "dataset_slug", "protocol_kind", "study_revision_label"],
      "properties": {
        "study_id": { "type": "string", "minLength": 1 },
        "dataset_slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "protocol_kind": { "type": "string", "minLength": 1 },
        "study_revision_label": { "type": "string", "minLength": 1 },
        "title": { "type": "string" }
      }
    },
    "source_repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "revision", "pinned_files"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "revision_committed_at": { "type": "string" },
        "pinned_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "role"],
            "properties": {
              "path": { "$ref": "#/$defs/relative_path" },
              "sha256": { "$ref": "#/$defs/sha256" },
              "role": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "dataset_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "sha256", "size_bytes", "row_count", "column_count", "read_format", "atlas_local_path"],
      "properties": {
        "source_provider": { "type": "string" },
        "source_reference": { "type": "string" },
        "file_name": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "row_count": { "type": "integer", "minimum": 1 },
        "column_count": { "type": "integer", "minimum": 1 },
        "read_format": { "enum": ["csv"] },
        "read_options": { "type": "object" },
        "atlas_local_path": { "$ref": "#/$defs/relative_path" },
        "study_source_contract_path": { "$ref": "#/$defs/relative_path" }
      }
    },
    "scientific_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "core_packages", "lock", "compatibility_policy"],
      "properties": {
        "python": { "type": "string" },
        "platform": { "type": ["string", "null"] },
        "core_packages": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        },
        "lock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "format"],
          "properties": {
            "path": { "$ref": "#/$defs/relative_path" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "format": { "type": "string" },
            "python_version_file": { "$ref": "#/$defs/relative_path" }
          }
        },
        "compatibility_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "python": { "enum": ["exact", "same_minor", "same_major"] },
            "core_packages": { "enum": ["exact", "same_minor", "same_major"] },
            "platform": { "enum": ["difference_is_compatible", "difference_is_incompatible"] },
            "rationale": { "type": "string" }
          }
        }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem_type", "target", "identifier_columns"],
      "properties": {
        "problem_type": { "type": "string" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["column"],
          "properties": {
            "column": { "type": "string" },
            "classes": { "type": "array" },
            "positive_class": {},
            "encoding": { "type": "object" }
          }
        },
        "identifier_columns": { "type": "array", "items": { "type": "string" } }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_columns", "numerical", "categorical"],
      "properties": {
        "feature_columns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "numerical": { "type": "array", "items": { "type": "string" } },
        "categorical": { "type": "array", "items": { "type": "string" } },
        "excluded_columns": { "type": "array", "items": { "type": "string" } }
      }
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules", "row_removal"],
      "properties": {
        "rules": { "type": "array", "items": { "$ref": "#/$defs/kind_object" } },
        "row_removal": { "enum": ["none", "declared_rules_only"] }
      }
    },
    "split": { "$ref": "#/$defs/kind_object" },
    "preprocessing": { "$ref": "#/$defs/kind_object" },
    "cross_validation": { "$ref": "#/$defs/kind_object" },
    "metrics": {
      "type": "object",
      "required": ["primary", "evaluated"],
      "properties": {
        "primary": { "type": "string" },
        "refit": { "type": "string" },
        "evaluated": { "type": "array", "items": { "type": "string" } },
        "default_threshold": { "type": "number" }
      }
    },
    "baseline": { "$ref": "#/$defs/candidate" },
    "candidates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/candidate" } },
    "search_execution": { "type": "object" },
    "selection": { "$ref": "#/$defs/kind_object" },
    "threshold_policy": { "$ref": "#/$defs/kind_object" },
    "final_evaluation": { "$ref": "#/$defs/kind_object" },
    "tolerance_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numeric_absolute", "count_absolute", "rationale"],
      "properties": {
        "numeric_absolute": { "type": "number", "minimum": 0 },
        "count_absolute": { "type": "integer", "minimum": 0 },
        "rationale": { "type": "string", "minLength": 1 },
        "declared_before_first_reproduction": { "type": "boolean" }
      }
    },
    "expected_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "decisions"],
      "properties": {
        "values": { "type": "array", "items": { "$ref": "#/$defs/expected_value" } },
        "decisions": { "type": "array", "items": { "$ref": "#/$defs/expected_value" } }
      }
    },
    "evidence_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap_id", "severity", "description"],
        "properties": {
          "gap_id": { "type": "string" },
          "severity": { "enum": ["blocking", "informational"] },
          "description": { "type": "string" }
        }
      }
    },
    "study_observations": { "type": "array", "items": { "type": "object" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authored_by", "authored_at", "method"],
      "properties": {
        "authored_by": { "type": "string" },
        "authored_at": { "type": "string" },
        "method": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "not": { "anyOf": [{ "pattern": "^/" }, { "pattern": "(^|/)\\.\\.(/|$)" }, { "pattern": "^[A-Za-z]:" }] }
    },
    "kind_object": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "type": "string", "minLength": 1 } }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "family", "fixed_params", "numerical_scaling", "search"],
      "properties": {
        "model_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "family": { "type": "string" },
        "study_estimator_class": { "type": "string" },
        "fixed_params": { "type": "object" },
        "numerical_scaling": { "enum": ["standard", "passthrough"] },
        "search": { "$ref": "#/$defs/kind_object" },
        "eligible_for_selection": { "type": "boolean" }
      }
    },
    "expected_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quantity", "expected", "comparison", "source"],
      "properties": {
        "quantity": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$" },
        "expected": {},
        "comparison": { "enum": ["numeric", "count", "exact"] },
        "reported_decimal_places": { "type": ["integer", "null"], "minimum": 0 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "locator", "rendered_text"],
          "properties": {
            "path": { "$ref": "#/$defs/relative_path" },
            "locator": { "type": "string", "minLength": 1 },
            "rendered_text": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
