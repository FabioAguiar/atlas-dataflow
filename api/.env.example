API_HOST=0.0.0.0
API_PORT=8000
# RELEASES_ROOT=/absolute/path/to/releases

# Atlas API backend configuration (see ../.env.example for the full annotated
# list). Placeholders only; never commit real values.
ATLAS_ADMIN_ENABLED=false
ATLAS_SUPABASE_JWT_ISSUER=<supabase-jwt-issuer>
ATLAS_SUPABASE_JWT_AUDIENCE=authenticated
ATLAS_SUPABASE_JWKS_URL=<supabase-jwks-url>
# Default false. "true" permits plain-http JWKS only for loopback, RFC1918,
# IPv6 ULA/loopback or single-label service hosts (trusted Docker network).
ATLAS_SUPABASE_JWKS_ALLOW_PRIVATE_HTTP=false
ATLAS_ADMIN_USER_ID=<atlas-admin-user-uuid>
ATLAS_INFERENCE_GATEWAY_TOKEN=<set-in-deployment>
