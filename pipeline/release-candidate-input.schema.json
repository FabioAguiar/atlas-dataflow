{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-dataflow.local/schemas/pipeline/release-candidate-input.schema.json",
  "title": "Atlas DataFlow Release Candidate Input",
  "description": "Pre-assembly input contract for a governed release candidate. This schema defines the M26 release candidate input boundary before pipeline candidate assembly. It enumerates required M22 through M25 artifacts, stable dataset and release identities, source references, hashes, public projection classification, internal evidence boundaries, and deterministic placeholder handling without performing candidate assembly, publisher validation, manifest generation, promotion, registry activation, runtime inference, or model training.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "input_kind",
    "dataset_identity",
    "release_identity",
    "source_run",
    "artifact_inputs",
    "candidate_mapping",
    "classification_policy",
    "boundary_confirmations"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "release-candidate-input.v1",
      "description": "Fixed version for the first release candidate input contract."
    },
    "input_kind": {
      "type": "string",
      "const": "release_candidate_input",
      "description": "Declares that this document is the governed pre-assembly input set, not an assembled release candidate or publisher manifest."
    },
    "dataset_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_slug"
      ],
      "description": "Dataset identity that must map to pipeline/candidate-layout.schema.json and publisher/release-candidate.schema.json. It must be explicit and must not be inferred from a local path, fixture name, or notebook state.",
      "properties": {
        "dataset_slug": {
          "$ref": "#/$defs/dataset_slug"
        },
        "dataset_title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "release_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "release_version",
        "created_at"
      ],
      "description": "Release identity that must remain compatible with existing candidate layout, release candidate, manifest, and validation schemas.",
      "properties": {
        "release_id": {
          "$ref": "#/$defs/release_id"
        },
        "release_version": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "source_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "producer",
        "created_at"
      ],
      "description": "Traceability for the pre-assembly input selection run. This does not make the input set publishable.",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "artifact_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovery_evidence",
        "promoted_contracts",
        "preparation_recipe",
        "prepared_data_metadata",
        "training_parameter_record",
        "model_artifact",
        "training_metrics",
        "model_card",
        "public_context",
        "visualizations",
        "inference_bundle",
        "internal_evidence_references"
      ],
      "description": "Governed artifact roles consumed before candidate assembly. Required roles must reference real dataflow outputs with hashes or an explicit hash policy. The visualizations role is required (Project Spec S0128): a release-bound analytical visualizations artifact reference, not an optional one.",
      "properties": {
        "discovery_evidence": {
          "allOf": [
            {
              "$ref": "#/$defs/required_internal_artifact_input"
            },
            {
              "properties": {
                "role": {
                  "const": "discovery_evidence"
                },
                "source_stage": {
                  "const": "M22"
                },
                "contract_version": {
                  "const": "dataset-discovery-evidence.v1"
                }
              }
            }
          ],
          "description": "M22 dataset discovery evidence input."
        },
        "promoted_contracts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "execution_contract",
            "runtime_contract",
            "public_contract"
          ],
          "description": "Promoted contract inputs. Runtime and execution contracts remain internal; the public contract is publisher-visible.",
          "properties": {
            "execution_contract": {
              "allOf": [
                {
                  "$ref": "#/$defs/required_internal_artifact_input"
                },
                {
                  "properties": {
                    "role": {
                      "const": "execution_contract"
                    },
                    "contract_version": {
                      "minLength": 1
                    }
                  }
                }
              ]
            },
            "runtime_contract": {
              "allOf": [
                {
                  "$ref": "#/$defs/required_internal_artifact_input"
                },
                {
                  "properties": {
                    "role": {
                      "const": "runtime_contract"
                    },
                    "contract_version": {
                      "minLength": 1
                    }
                  }
                }
              ]
            },
            "public_contract": {
              "allOf": [
                {
                  "$ref": "#/$defs/required_public_artifact_input"
                },
                {
                  "properties": {
                    "role": {
                      "const": "public_contract"
                    },
                    "contract_version": {
                      "minLength": 1
                    }
                  }
                }
              ]
            }
          }
        },
        "preparation_recipe": {
          "allOf": [
            {
              "$ref": "#/$defs/required_internal_artifact_input"
            },
            {
              "properties": {
                "role": {
                  "const": "preparation_recipe"
                },
                "source_stage": {
                  "const": "M22"
                },
                "contract_version": {
                  "const": "candidate-preparation-recipe.v1"
                }
              }
            }
          ]
        },
        "prepared_data_metadata": {
          "allOf": [
            {
              "$ref": "#/$defs/required_internal_artifact_input"
            },
            {
              "properties": {
                "role": {
                  "const": "prepared_data_metadata"
                },
                "source_stage": {
                  "enum": [
                    "M22",
                    "M23"
                  ]
                }
              }
            }
          ],
          "description": "Metadata for the prepared dataset consumed by training and candidate assembly. This role records metadata and hashes, not raw prepared data contents."
        },
        "training_parameter_record": {
          "allOf": [
            {
              "$ref": "#/$defs/required_internal_artifact_input"
            },
            {
              "properties": {
                "role": {
                  "const": "training_parameter_record"
                },
                "source_stage": {
                  "enum": ["M24", "manual_governed_input"]
                },
                "contract_version": {
                  "enum": [
                    "training-parameter-record.v1",
                    "training-parameter-record.external-fitted-model.v1"
                  ]
                }
              }
            }
          ],
          "description": "Project Spec S0180: source_stage/contract_version are M24/training-parameter-record.v1 for internal training, or manual_governed_input/training-parameter-record.external-fitted-model.v1 for a validated external fitted model (Project Spec S0157). Discriminated by the referenced artifact's own declared schema_version, never by dataset_slug."
        },
        "model_artifact": {
          "allOf": [
            {
              "$ref": "#/$defs/required_internal_artifact_input"
            },
            {
              "properties": {
                "role": {
                  "const": "model_artifact"
                },
                "source_stage": {
                  "enum": ["M24", "manual_governed_input"]
                },
                "contract_version": {
                  "const": "model_artifact_reference"
                }
              }
            }
          ],
          "description": "Serialized model artifact reference and hash. The artifact bytes are not embedded. Project Spec S0180: source_stage is manual_governed_input, not M24, when this role's model artifact originates from a validated external fitted model rather than an Atlas training run."
        },
        "training_metrics": {
          "allOf": [
            {
              "$ref": "#/$defs/required_public_artifact_input"
            },
            {
              "properties": {
                "role": {
                  "const": "training_metrics"
                },
                "source_stage": {
                  "enum": ["M24", "manual_governed_input"]
                },
                "contract_version": {
                  "enum": [
                    "training-metrics.v1",
                    "training-metrics.external-fitted-model.v1"
                  ]
                }
              }
            }
          ],
          "description": "Project Spec S0180: source_stage/contract_version are M24/training-metrics.v1 for internal training, or manual_governed_input/training-metrics.external-fitted-model.v1 for a validated external fitted model (Project Spec S0157)."
        },
        "model_card": {
          "allOf": [
            {
              "$ref": "#/$defs/required_public_artifact_input"
            },
            {
              "properties": {
                "role": {
                  "const": "model_card"
                },
                "source_stage": {
                  "const": "M24"
                }
              }
            }
          ]
        },
        "public_context": {
          "allOf": [
            {
              "$ref": "#/$defs/required_public_artifact_input"
            },
            {
              "properties": {
                "role": {
                  "const": "public_context"
                }
              }
            }
          ]
        },
        "visualizations": {
          "allOf": [
            {
              "$ref": "#/$defs/required_public_artifact_input"
            },
            {
              "properties": {
                "role": {
                  "const": "visualizations"
                },
                "source_stage": {
                  "const": "M24"
                },
                "contract_version": {
                  "const": "analytical-visualizations.v1"
                }
              }
            }
          ],
          "description": "Project Spec S0128: required, release-bound analytical visualizations artifact reference (Target Distribution and Feature Importance), produced during governed training."
        },
        "inference_bundle": {
          "allOf": [
            {
              "$ref": "#/$defs/required_internal_artifact_input"
            },
            {
              "properties": {
                "role": {
                  "const": "inference_bundle"
                },
                "source_stage": {
                  "const": "M25"
                },
                "contract_version": {
                  "const": "inference_bundle.v1"
                }
              }
            }
          ]
        },
        "internal_evidence_references": {
          "type": "array",
          "minItems": 1,
          "description": "Internal reduced evidence references used for traceability. These are not publisher-visible public artifacts.",
          "items": {
            "$ref": "#/$defs/internal_evidence_reference"
          }
        }
      }
    },
    "candidate_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_layout_schema",
        "publisher_release_candidate_schema",
        "publisher_release_manifest_schema",
        "publisher_validation_schema",
        "role_mappings"
      ],
      "description": "Explicit mapping from pre-assembly inputs to existing post-assembly candidate, manifest, and validation surfaces. This prevents the input contract from replacing those downstream schemas.",
      "properties": {
        "candidate_layout_schema": {
          "type": "string",
          "const": "pipeline/candidate-layout.schema.json"
        },
        "publisher_release_candidate_schema": {
          "type": "string",
          "const": "publisher/release-candidate.schema.json"
        },
        "publisher_release_manifest_schema": {
          "type": "string",
          "const": "publisher/release-manifest.schema.json"
        },
        "publisher_validation_schema": {
          "type": "string",
          "const": "publisher/validation/release-candidate-validation.schema.json"
        },
        "role_mappings": {
          "type": "array",
          "minItems": 8,
          "items": {
            "$ref": "#/$defs/role_mapping"
          }
        }
      }
    },
    "classification_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_required_input",
        "fixture_only_required_input",
        "placeholder_only_required_input",
        "unsafe_public_projection",
        "internal_absolute_path_in_public_reference"
      ],
      "description": "Deterministic classification rules for invalid or incomplete release candidate inputs.",
      "properties": {
        "missing_required_input": {
          "type": "string",
          "const": "reject"
        },
        "fixture_only_required_input": {
          "type": "string",
          "const": "reject"
        },
        "placeholder_only_required_input": {
          "type": "string",
          "const": "reject"
        },
        "unsafe_public_projection": {
          "type": "string",
          "const": "reject"
        },
        "internal_absolute_path_in_public_reference": {
          "type": "string",
          "const": "reject"
        }
      }
    },
    "boundary_confirmations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_assembly_performed",
        "publisher_validation_performed",
        "manifest_generation_performed",
        "promotion_performed",
        "registry_activation_performed",
        "runtime_inference_performed",
        "model_training_performed",
        "raw_artifact_contents_embedded",
        "raw_logs_persisted",
        "raw_runtime_persisted",
        "raw_api_payloads_persisted",
        "secrets_persisted",
        "public_artifacts_include_internal_evidence"
      ],
      "description": "Boundary controls confirming that this input contract is a declaration of inputs only.",
      "properties": {
        "candidate_assembly_performed": {
          "type": "boolean",
          "const": false
        },
        "publisher_validation_performed": {
          "type": "boolean",
          "const": false
        },
        "manifest_generation_performed": {
          "type": "boolean",
          "const": false
        },
        "promotion_performed": {
          "type": "boolean",
          "const": false
        },
        "registry_activation_performed": {
          "type": "boolean",
          "const": false
        },
        "runtime_inference_performed": {
          "type": "boolean",
          "const": false
        },
        "model_training_performed": {
          "type": "boolean",
          "const": false
        },
        "raw_artifact_contents_embedded": {
          "type": "boolean",
          "const": false
        },
        "raw_logs_persisted": {
          "type": "boolean",
          "const": false
        },
        "raw_runtime_persisted": {
          "type": "boolean",
          "const": false
        },
        "raw_api_payloads_persisted": {
          "type": "boolean",
          "const": false
        },
        "secrets_persisted": {
          "type": "boolean",
          "const": false
        },
        "public_artifacts_include_internal_evidence": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "example_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "example_only",
        "not_release_evidence"
      ],
      "description": "Optional marker for examples under pipeline/examples/. Production release candidate input documents should omit this field.",
      "properties": {
        "example_only": {
          "type": "boolean",
          "const": true
        },
        "not_release_evidence": {
          "type": "boolean",
          "const": true
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "model_delivery": {
      "$ref": "#/$defs/model_delivery_declaration",
      "description": "Governed release-owned model delivery declaration. The implementation-time source location is deliberately not durable metadata."
    },
    "capability_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_slug",
        "authoring_generation_id",
        "authoring_manifest_ref",
        "capability_profile_id",
        "capability_profile_version",
        "capability_profile_ref",
        "resolved_role_policy"
      ],
      "description": "Project Spec S0168. Optional capability-aware package identity for this release-candidate input, evolved purely additively (new optional property, same contract_version const, existing required array unchanged). Absent for historical release-candidate-input.v1 instances, which remain valid and are interpreted exactly as before. When present, resolved_role_policy is the explicit, capability-profile-derived applicability (required/optional/forbidden) for artifact roles governed by this release; it must not require a forbidden role to appear and must not use a placeholder artifact to stand in for an inapplicable role. Applicability must be resolved from the referenced capability profile, never inferred from dataset_slug, Telco identity, filesystem existence, or a milestone id.",
      "properties": {
        "dataset_slug": {
          "$ref": "#/$defs/dataset_slug",
          "description": "Must match dataset_identity.dataset_slug."
        },
        "authoring_generation_id": {
          "$ref": "#/$defs/identifier",
          "description": "Identifies the immutable Atlas authoring generation this release is built from (pipeline/dataset-integration-authoring-manifest.schema.json#/properties/authoring_generation/properties/authoring_generation_id)."
        },
        "authoring_manifest_ref": {
          "allOf": [
            { "$ref": "#/$defs/governed_reference" },
            {
              "properties": {
                "contract_version": {
                  "type": "string",
                  "const": "dataset-integration-authoring-manifest.v1"
                }
              }
            }
          ],
          "description": "Governed reference (path + sha256) to the dataset-integration authoring manifest. Never embeds the manifest payload."
        },
        "capability_profile_id": {
          "$ref": "#/$defs/capability_identifier",
          "description": "Architecture-level capability family identifier (pipeline/capability-profile.schema.json#/properties/capability_profile_id). Must never be a dataset slug or dataset-specific identity."
        },
        "capability_profile_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^v[0-9]+$"
        },
        "capability_profile_ref": {
          "$ref": "#/$defs/governed_reference",
          "description": "Governed reference (path + sha256) to the concrete capability profile document. Never embeds the profile payload."
        },
        "resolved_role_policy": {
          "type": "array",
          "minItems": 1,
          "description": "Explicit, capability-profile-derived applicability (required/optional/forbidden) for artifact roles governed by this release, and whether each is present in this candidate.",
          "items": { "$ref": "#/$defs/role_policy_entry" }
        }
      }
    }
  },
  "$defs": {
    "model_delivery_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "artifact_id", "artifact_format", "loader_family", "expected_sha256", "destination_path", "inference_bundle_id", "provenance"],
      "properties": {
        "role": {"type": "string", "const": "model_artifact"},
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "artifact_format": {"type": "string", "minLength": 1},
        "loader_family": {"type": "string", "minLength": 1},
        "expected_sha256": {"$ref": "#/$defs/sha256_hex"},
        "destination_path": {"$ref": "#/$defs/safe_relative_file_path"},
        "inference_bundle_id": {"$ref": "#/$defs/identifier"},
        "provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["source_reference"],
          "properties": {"source_reference": {"type": "string", "minLength": 1}, "source_revision": {"type": "string", "minLength": 1}}
        }
      }
    },
    "dataset_slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[-._][a-z0-9]+)*$"
    },
    "sha256_hex": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "safe_relative_file_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*\\\\)(?![A-Za-z]:)(?!.*(?:^|/)(?:\\.env|logs|runtime/logs|runtime/tmp|runtime/cache|runtime/data)(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*[^/]$",
      "description": "Repository- or release-relative file reference. Absolute paths, parent traversal, repeated separators, Windows paths, URI-like references, runtime/log/cache/data paths, and directory-only references are invalid."
    },
    "artifact_presence": {
      "type": "string",
      "enum": [
        "real_dataflow_artifact",
        "not_available"
      ]
    },
    "hash_policy": {
      "type": "string",
      "enum": [
        "sha256_required",
        "sha256_verified_by_downstream_manifest"
      ]
    },
    "public_projection": {
      "type": "string",
      "enum": [
        "public_artifact",
        "internal_only",
        "public_reference_only"
      ]
    },
    "evidence_classification": {
      "type": "string",
      "enum": [
        "public_artifact",
        "internal_evidence",
        "internal_traceability_reference",
        "not_evidence"
      ]
    },
    "placeholder_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixtures_allowed",
        "placeholders_allowed",
        "missing_required_behavior"
      ],
      "properties": {
        "fixtures_allowed": {
          "type": "boolean",
          "const": false
        },
        "placeholders_allowed": {
          "type": "boolean",
          "const": false
        },
        "missing_required_behavior": {
          "type": "string",
          "const": "reject"
        }
      }
    },
    "artifact_input_base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "required",
        "source_stage",
        "path",
        "contract_version",
        "hash_policy",
        "public_projection",
        "evidence_classification",
        "placeholder_policy",
        "availability_status"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "source_stage": {
          "type": "string",
          "enum": [
            "M22",
            "M23",
            "M24",
            "M25",
            "M26",
            "manual_governed_input"
          ]
        },
        "path": {
          "$ref": "#/$defs/safe_relative_file_path"
        },
        "contract_version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256_hex"
        },
        "hash_policy": {
          "$ref": "#/$defs/hash_policy"
        },
        "public_projection": {
          "$ref": "#/$defs/public_projection"
        },
        "evidence_classification": {
          "$ref": "#/$defs/evidence_classification"
        },
        "placeholder_policy": {
          "$ref": "#/$defs/placeholder_policy"
        },
        "availability_status": {
          "$ref": "#/$defs/artifact_presence"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "required_internal_artifact_input": {
      "allOf": [
        {
          "$ref": "#/$defs/artifact_input_base"
        },
        {
          "required": [
            "sha256"
          ],
          "properties": {
            "required": {
              "const": true
            },
            "public_projection": {
              "enum": [
                "internal_only",
                "public_reference_only"
              ]
            },
            "evidence_classification": {
              "enum": [
                "internal_evidence",
                "internal_traceability_reference",
                "not_evidence"
              ]
            },
            "availability_status": {
              "const": "real_dataflow_artifact"
            }
          }
        }
      ]
    },
    "required_public_artifact_input": {
      "allOf": [
        {
          "$ref": "#/$defs/artifact_input_base"
        },
        {
          "required": [
            "sha256"
          ],
          "properties": {
            "required": {
              "const": true
            },
            "public_projection": {
              "enum": [
                "public_artifact",
                "public_reference_only"
              ]
            },
            "availability_status": {
              "const": "real_dataflow_artifact"
            }
          }
        }
      ]
    },
    "internal_evidence_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "sha256",
        "source_stage",
        "evidence_classification",
        "public_projection"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "discovery_evidence",
            "preparation_evidence",
            "training_evidence",
            "external_model_evidence",
            "model_selection_evidence",
            "inference_bundle_evidence",
            "candidate_assembly_evidence"
          ],
          "description": "Project Spec S0180: external_model_evidence is the internal evidence role for a validated external fitted model, used instead of training_evidence -- never both for the same candidate input."
        },
        "path": {
          "$ref": "#/$defs/safe_relative_file_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256_hex"
        },
        "source_stage": {
          "type": "string",
          "enum": [
            "M22",
            "M23",
            "M24",
            "M25",
            "M26",
            "manual_governed_input"
          ]
        },
        "evidence_classification": {
          "type": "string",
          "const": "internal_evidence"
        },
        "public_projection": {
          "type": "string",
          "const": "internal_only"
        }
      }
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[-._][a-z0-9]+)*$"
    },
    "capability_identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "role_applicability": {
      "type": "string",
      "enum": ["required", "optional", "forbidden"]
    },
    "governed_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/safe_relative_file_path" },
        "sha256": { "$ref": "#/$defs/sha256_hex" }
      }
    },
    "role_policy_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_name", "applicability", "present"],
      "description": "One artifact role's resolved applicability under a capability profile, and whether it is present in this release candidate input. A forbidden role must never be present; a required role must be present.",
      "properties": {
        "role_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "applicability": { "$ref": "#/$defs/role_applicability" },
        "present": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "applicability": { "const": "forbidden" } },
            "required": ["applicability"]
          },
          "then": { "properties": { "present": { "const": false } } }
        },
        {
          "if": {
            "properties": { "applicability": { "const": "required" } },
            "required": ["applicability"]
          },
          "then": { "properties": { "present": { "const": true } } }
        }
      ]
    },
    "role_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_role",
        "candidate_role",
        "publisher_role",
        "mapping_requirement"
      ],
      "properties": {
        "input_role": {
          "type": "string",
          "minLength": 1
        },
        "candidate_role": {
          "type": "string",
          "minLength": 1
        },
        "publisher_role": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "mapping_requirement": {
          "type": "string",
          "enum": [
            "must_map_to_candidate_artifact_role",
            "must_remain_internal_evidence",
            "optional_when_available"
          ]
        }
      }
    }
  }
}
