{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-dataflow.local/schemas/external-inference/external-inference-request.schema.json",
  "title": "external_inference_request.v1",
  "description": "Strict, versioned internal request contract for the isolated external-inference service. Data-only: bounded Atlas-controlled bundle/runtime identity plus an already-validated, normalized feature payload. Never a filesystem path, loader/module name, serialized object, dependency override, or hash bypass.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "release_identity", "bundle_identity", "expected_runtime", "feature_payload"],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "external_inference_request.v1"
    },
    "release_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id"],
      "properties": {
        "release_id": {
          "type": "string",
          "pattern": "^release-[A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      }
    },
    "bundle_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_id", "dataset_slug"],
      "properties": {
        "bundle_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "expected_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_major_minor", "joblib", "pandas", "scikit_learn"],
      "properties": {
        "python_major_minor": {
          "type": "string",
          "minLength": 1
        },
        "joblib": {
          "type": "string",
          "minLength": 1
        },
        "pandas": {
          "type": "string",
          "minLength": 1
        },
        "scikit_learn": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "feature_payload": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean"]
      }
    }
  }
}
