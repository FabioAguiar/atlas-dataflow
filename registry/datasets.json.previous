{
  "$schema": "./schema",
  "schema_version": "atlas.dataflow.registry.v1",
  "conventions": {
    "dataset_slug": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Public dataset identity. Use lowercase ASCII letters, digits, and single hyphen separators. Do not encode local paths, private names, or release details in the slug."
    },
    "release_id": {
      "pattern": "^release-[0-9]{8}-[0-9]{3}$",
      "description": "Published release identifier for the first public cycle, formatted as release-YYYYMMDD-NNN. The identifier names an immutable release package outside this registry."
    },
    "active_release": {
      "description": "Each published dataset must declare exactly one active_release value. The active release is explicit registry data and must not be inferred from file scanning, latest runs, timestamps, directory order, or fallback artifacts."
    }
  },
  "datasets": [
