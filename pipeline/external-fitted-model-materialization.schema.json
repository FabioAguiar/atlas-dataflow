{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-dataflow.local/schemas/pipeline/external-fitted-model-materialization.schema.json",
  "title": "Atlas DataFlow External Fitted-Model Materialization Result",
  "description": "Project Spec S0181: durable, schema-backed result of governed materialization of an already-validated external fitted model (Project Spec S0157 model_source_mode: validated_external_fitted_model) into Atlas-owned repository artifacts. Never embeds raw model bytes, secrets, notebook state, or external absolute paths. A materialized result carries exactly the fields already consumed by pipeline.generate_inference_bundle.materialize_governed_inference_bundle's external branch (Project Spec S0180), plus additional integrity/traceability fields. A blocked result never claims materialized status and always carries concrete, stable-coded blocking reasons.",
  "type": "object",
  "required": ["schema_version", "artifact_kind", "status"],
  "oneOf": [
    { "$ref": "#/$defs/materialized_result_v1" },
    { "$ref": "#/$defs/blocked_result_v1" }
  ],
  "$defs": {
    "materialized_result_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_kind",
        "status",
        "created_at",
        "materialization_identity",
        "model_source_mode",
        "dataset_identity",
        "evidence_references",
        "evidence_hashes",
        "model_artifact_path",
        "model_artifact_sha256",
        "model_state_fingerprint",
        "runtime_compatibility",
        "educational_threshold",
        "final_test_completion",
        "operational_readiness",
        "boundary_confirmations"
      ],
      "properties": {
        "schema_version": { "const": "external-fitted-model-materialization.v1" },
        "artifact_kind": { "const": "external_fitted_model_materialization_result" },
        "status": { "const": "materialized" },
        "created_at": { "type": "string", "format": "date-time" },
        "materialization_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["materialization_id", "producer"],
          "properties": {
            "materialization_id": { "type": "string", "minLength": 1 },
            "producer": {
              "type": "string",
              "minLength": 1,
              "description": "Identity of the generic materializer that produced this result, e.g. pipeline.materialize_external_fitted_model."
            }
          }
        },
        "model_source_mode": { "const": "validated_external_fitted_model" },
        "dataset_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dataset_slug"],
          "properties": {
            "dataset_slug": { "$ref": "#/$defs/dataset_slug" }
          }
        },
        "evidence_references": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "training_parameter_record_path",
            "training_metrics_path",
            "model_selection_evidence_path"
          ],
          "description": "Atlas-owned, repository-relative references to the projected S0157 external-profile evidence artifacts this materializer wrote -- never the caller's original external source paths.",
          "properties": {
            "training_parameter_record_path": { "$ref": "#/$defs/safe_relative_file_path" },
            "training_metrics_path": { "$ref": "#/$defs/safe_relative_file_path" },
            "model_selection_evidence_path": { "$ref": "#/$defs/safe_relative_file_path" }
          }
        },
        "evidence_hashes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "training_parameter_record_sha256",
            "training_metrics_sha256",
            "model_selection_evidence_sha256"
          ],
          "description": "SHA-256 of the Atlas-native projected evidence bytes actually written by this materializer.",
          "properties": {
            "training_parameter_record_sha256": { "$ref": "#/$defs/sha256_hex" },
            "training_metrics_sha256": { "$ref": "#/$defs/sha256_hex" },
            "model_selection_evidence_sha256": { "$ref": "#/$defs/sha256_hex" }
          }
        },
        "model_artifact_path": { "$ref": "#/$defs/safe_relative_file_path" },
        "model_artifact_sha256": { "$ref": "#/$defs/sha256_hex" },
        "model_state_fingerprint": {
          "$ref": "#/$defs/sha256_hex",
          "description": "Semantic fingerprint of the fitted model's state, cross-checked against the corresponding external training-parameter-record and model-selection-evidence at materialization time."
        },
        "runtime_compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["serialization_format", "loader_strategy", "load_safety_confirmed"],
          "description": "Load-safety/compatibility metadata carried forward for a later, separately authorized runtime binding. Never implies the model was imported or deserialized by this materializer.",
          "properties": {
            "serialization_format": { "type": "string", "minLength": 1 },
            "loader_strategy": { "type": "string", "minLength": 1 },
            "load_safety_confirmed": { "type": "boolean" }
          }
        },
        "educational_threshold": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "scenario"],
          "description": "Propagated without operational reinterpretation. Never labeled or consumed as an operational threshold.",
          "properties": {
            "value": { "type": "number", "minimum": 0, "maximum": 1 },
            "scenario": { "type": "string", "minLength": 1 }
          }
        },
        "final_test_completion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["used_for_threshold_selection", "evaluation_count"],
          "description": "Propagated without re-evaluation. A materialized (successful) result always reflects a sealed, single, non-threshold-selecting final-test evaluation.",
          "properties": {
            "used_for_threshold_selection": { "type": "boolean", "const": false },
            "evaluation_count": { "type": "integer", "const": 1 }
          }
        },
        "operational_readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "educational_final_model_complete",
            "educational_inference_demo_ready",
            "operational_validity",
            "operational_threshold",
            "operational_prediction_available"
          ],
          "description": "Propagated fail-closed. Unresolved operational readiness never becomes an implicit promotion grant.",
          "properties": {
            "educational_final_model_complete": { "type": "boolean" },
            "educational_inference_demo_ready": { "type": "boolean" },
            "operational_validity": { "type": "string", "enum": ["confirmed", "unconfirmed"] },
            "operational_threshold": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "value"],
              "properties": {
                "status": { "type": "string", "enum": ["resolved", "unresolved"] },
                "value": { "type": ["number", "null"] }
              },
              "allOf": [
                {
                  "if": { "properties": { "status": { "const": "unresolved" } }, "required": ["status"] },
                  "then": { "properties": { "value": { "const": null } } }
                },
                {
                  "if": { "properties": { "status": { "const": "resolved" } }, "required": ["status"] },
                  "then": { "properties": { "value": { "type": "number" } } }
                }
              ]
            },
            "operational_prediction_available": { "type": "boolean" }
          },
          "allOf": [
            {
              "description": "operational_prediction_available = true is rejected when operational_validity is unconfirmed.",
              "if": {
                "properties": { "operational_prediction_available": { "const": true } },
                "required": ["operational_prediction_available"]
              },
              "then": { "properties": { "operational_validity": { "const": "confirmed" } } }
            }
          ]
        },
        "boundary_confirmations": { "$ref": "#/$defs/boundary_confirmations" }
      }
    },
    "blocked_result_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "artifact_kind", "status", "created_at", "blocking_reasons", "boundary_confirmations"],
      "properties": {
        "schema_version": { "const": "external-fitted-model-materialization.v1" },
        "artifact_kind": { "const": "external_fitted_model_materialization_result" },
        "status": { "const": "blocked" },
        "created_at": { "type": "string", "format": "date-time" },
        "materialization_identity": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["materialization_id", "producer"],
              "properties": {
                "materialization_id": { "type": "string", "minLength": 1 },
                "producer": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "dataset_identity": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["dataset_slug"],
              "properties": { "dataset_slug": { "type": "string" } }
            }
          ]
        },
        "blocking_reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 },
              "field": { "type": ["string", "null"] }
            }
          }
        },
        "boundary_confirmations": { "$ref": "#/$defs/boundary_confirmations" }
      }
    },
    "boundary_confirmations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atlas_training_invoked",
        "estimator_fit_or_fit_transform_called",
        "model_selection_performed",
        "threshold_optimized",
        "inference_performed",
        "model_bytes_imported_or_deserialized",
        "training_run_identity_fabricated",
        "external_models_created_or_recreated",
        "external_project_root_retained"
      ],
      "properties": {
        "atlas_training_invoked": { "type": "boolean", "const": false },
        "estimator_fit_or_fit_transform_called": { "type": "boolean", "const": false },
        "model_selection_performed": { "type": "boolean", "const": false },
        "threshold_optimized": { "type": "boolean", "const": false },
        "inference_performed": { "type": "boolean", "const": false },
        "model_bytes_imported_or_deserialized": { "type": "boolean", "const": false },
        "training_run_identity_fabricated": { "type": "boolean", "const": false },
        "external_models_created_or_recreated": { "type": "boolean", "const": false },
        "external_project_root_retained": { "type": "boolean", "const": false }
      }
    },
    "dataset_slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256_hex": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "safe_relative_file_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*\\\\)(?![A-Za-z]:)(?!pipeline/training-runs/)(?!external-models/)[A-Za-z0-9][A-Za-z0-9._/-]*[^/]$",
      "description": "Repository-relative file reference. Absolute paths, parent traversal, repeated separators, Windows paths, pipeline/training-runs/ (never a fabricated Atlas training-run identity), external-models/ (never recreated), and directory-only references are invalid."
    }
  }
}
